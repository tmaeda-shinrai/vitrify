# =====================================================
# .env.example — Variáveis de ambiente da Vitrine Digital
# =====================================================
# Copie este arquivo para .env.local e preencha com seus valores.
# Nunca comite .env.local. Mantenha .env.example sincronizado.
# =====================================================

# -----------------------------------------------------
# App
# -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vitri
NODE_ENV=development

# -----------------------------------------------------
# Supabase
# Pegue em: https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6Ik...

# Service role: NUNCA exponha ao cliente.
# Use apenas em route handlers, server actions ou edge functions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6Ik...

# Para CLI/migrations
SUPABASE_PROJECT_REF=seu-projeto
SUPABASE_DB_PASSWORD=senha_db

# -----------------------------------------------------
# Asaas (gateway de pagamento)
# Pegue em: https://www.asaas.com/config/integracoes
# -----------------------------------------------------
# Use sandbox em dev: https://sandbox.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=$aact_YTU5YTE0M2M2N2I4MTliNzk0YT...
ASAAS_WEBHOOK_SECRET=segredo_compartilhado_para_validar_webhooks

# IDs dos planos no Asaas (criar manualmente no painel após primeiro deploy)
ASAAS_PLAN_PRO_MONTHLY_ID=
ASAAS_PLAN_PRO_YEARLY_ID=
ASAAS_PLAN_PLUS_MONTHLY_ID=
ASAAS_PLAN_PLUS_YEARLY_ID=

# -----------------------------------------------------
# E-mail transacional (Resend)
# https://resend.com/api-keys
# -----------------------------------------------------
RESEND_API_KEY=re_123abc...
EMAIL_FROM=Vitri <ola@vitri.app>
EMAIL_REPLY_TO=suporte@vitri.app

# -----------------------------------------------------
# Observabilidade
# -----------------------------------------------------
# Sentry: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=vitri

# Plausible (analytics sem cookies)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vitri.app

# -----------------------------------------------------
# Rate limiting (Upstash Redis)
# https://console.upstash.com
# -----------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------
# OAuth (configurado no painel Supabase Auth)
# Estas variáveis aqui são para referência; o Supabase
# gerencia via dashboard.
# -----------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------
# Feature flags / config interna
# -----------------------------------------------------
# Habilita logs verbosos em dev
DEBUG_MODE=true

# Lista de e-mails admin separados por vírgula
ADMIN_EMAILS=admin@vitri.app

# Limites por plano (override opcional, defaults no código)
LIMIT_FREE_PRODUCTS=5
LIMIT_PRO_PRODUCTS=999
LIMIT_PLUS_VITRINES=3

# -----------------------------------------------------
# NF-e (após decisão entre NFE.io ou Asaas integrado)
# -----------------------------------------------------
# NFEIO_API_KEY=
# NFEIO_COMPANY_ID=

# =====================================================
# Notas
# =====================================================
# - Em produção, todas as variáveis acima devem estar
#   configuradas em Vercel > Project Settings > Environment Variables.
# - Use ambientes separados (Production, Preview, Development) na Vercel.
# - Webhook secrets devem ser longos e gerados com:
#     openssl rand -hex 32
# - Nunca compartilhe service role key em chat, e-mail
#   ou screenshot. Se vazou, rotacione imediatamente.

# Ambiente dos testes E2E (Playwright) — Supabase **local** (`supabase start`).
#
# O webServer do Playwright roda com NODE_ENV=test, então o Next carrega ESTE
# arquivo e IGNORA o .env.local (que aponta para o Supabase remoto). Assim as
# NEXT_PUBLIC_* entram tanto nos inlines quanto no objeto `process.env` do bundle
# do cliente (lib/env usa `safeParse(process.env)`), e o client do browser funciona.
#
# As chaves abaixo são as chaves demo PADRÃO do `supabase start` (idênticas em
# qualquer máquina, derivadas do JWT secret de demonstração) — NÃO são segredos e
# só funcionam contra a stack local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
